[Unit]
Description=Null//Short arrow-code launcher
Documentation=https://github.com/Null0Grid/null-short
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/null-short run
# A panic exit (Ctrl+Alt+Shift+Esc) is a clean exit, so it stays stopped.
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
